            "inhibitWhenAudio": false,
            "inhibitWhenCharging": false,
            "lockBeforeSleep": {{ if eq .chezmoi.hostname "innovation" }}false{{ else }}true{{ end }},
            "timeouts": [
{{- if ne .chezmoi.hostname "innovation" }}
                {
                    "idleAction": "lock",
                    "inhibitWhenAudio": false,
                    "inhibitWhenCharging": false,
                    "respectInhibitors": true,
                    "timeout": 600
                },
                {
                    "idleAction": "dpms off",
                    "returnAction": "dpms on",
                    "timeout": 1200
                },
                {
                    "idleAction": [
                        "suspendThenHibernate"
                    ],
                    "timeout": 1800
                }
{{- end }}
            ]
        }
