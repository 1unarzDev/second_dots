#!/usr/bin/env bash
set -euo pipefail
# Installed browser version: {{ if lookPath "pacman" }}{{ output "sh" "-c" "pacman -Q zen-browser-bin 2>/dev/null || true" | trim }}{{ end }}
# Bootstrap hash: {{ include ".chezmoitemplates/sine-bootstrap.sys.mjs" | sha256sum }}

# ── Zen / Sine ───────────────────────────────────────────────────────────────

ZEN_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/zen"
PROFILES_INI="$ZEN_CONFIG/profiles.ini"

find_zen_profile() {
  [[ -f "$PROFILES_INI" ]] || return 1

  awk -F= -v base="$ZEN_CONFIG" '
    function resolve(path, relative) {
      if (path ~ /^\//)
        return path

      return relative == "0" ? path : base "/" path
    }

    function save_profile() {
      if (section !~ /^\[Profile/ || profile_path == "")
        return

      resolved = resolve(profile_path, relative)

      if (is_default == "1")
        default_profile = resolved

      if (fallback == "")
        fallback = resolved
    }

    { sub(/\r$/, "") }

    /^\[/ {
      save_profile()

      section = $0
      profile_path = ""
      relative = "1"
      is_default = "0"
      next
    }

    section ~ /^\[Install/ && $1 == "Default" {
      install_profile = substr($0, index($0, "=") + 1)
      next
    }

    section ~ /^\[Profile/ && $1 == "Path" {
      profile_path = substr($0, index($0, "=") + 1)
      next
    }

    section ~ /^\[Profile/ && $1 == "IsRelative" {
      relative = $2
      next
    }

    section ~ /^\[Profile/ && $1 == "Default" {
      is_default = $2
      next
    }

    END {
      save_profile()

      if (install_profile != "")
        print resolve(install_profile, "1")
      else if (default_profile != "")
        print default_profile
      else if (fallback != "")
        print fallback
    }
  ' "$PROFILES_INI"
}

find_zen_root() {
  local candidate

  for candidate in \
    /opt/zen-browser-bin \
    /opt/zen-browser \
    /usr/lib/zen-browser \
    /usr/lib/zen; do
    if [[ -d "$candidate" ]] &&
      [[ -e "$candidate/zen" || -e "$candidate/zen-bin" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

append_user_pref() {
  local user_js="$1"
  local pref_name="$2"
  local pref_value="$3"
  local preference

  preference="user_pref(\"$pref_name\", $pref_value);"

  # Replace all prior values so restarts cannot restore a conflicting setting.
  PREF_NAME="$pref_name" python - "$user_js" <<'EOF'
import os, re, sys
from pathlib import Path
p = Path(sys.argv[1])
pattern = r'^\s*user_pref\(\s*"' + re.escape(os.environ['PREF_NAME']) + r'"\s*,'
content = ''.join(line for line in p.read_text().splitlines(True) if not re.match(pattern, line))
p.write_text(content.rstrip('\n') + '\n' if content else '')
EOF
  printf '%s\n' "$preference" >>"$user_js"
}

install_sine_bootstrap() {
  local chrome="$1"
  local bootstrap

  bootstrap="$chrome/JS/zz-chezmoi-sine-bootstrap.sys.mjs"

  mkdir -p "$chrome/JS"

  cat >"$bootstrap" <<'EOF'
{{ include ".chezmoitemplates/sine-bootstrap.sys.mjs" }}
EOF

  echo "==> Installed Sine mod bootstrap: $bootstrap"
}

install_sine() (
  local profile
  local chrome
  local zen_root
  local temp_dir
  local user_js
  local palette_source
  local palette_link
  local nebula_config
  local program_file

  if [[ ! -f "$PROFILES_INI" ]]; then
    echo "==> Creating initial Zen profile..."
    zen-browser --headless -CreateProfile "default"
    [[ -f "$PROFILES_INI" ]] || { echo "Zen did not create profiles.ini" >&2; return 1; }
  fi

  if ! profile="$(find_zen_profile)" || [[ -z "$profile" ]]; then
    echo "==> Error: Could not determine the active Zen profile." >&2
    return 1
  fi

  if [[ ! -d "$profile" ]]; then
    echo "==> Error: Detected Zen profile does not exist:" >&2
    echo "    $profile"
    echo "==> Start Zen once, close it, and rerun chezmoi." >&2
    return 1
  fi

  if ! zen_root="$(find_zen_root)"; then
    echo "==> Error: Zen installation directory could not be detected." >&2
    return 1
  fi

  if pgrep -u "$(id -u)" -x zen &>/dev/null || pgrep -u "$(id -u)" -x zen-bin &>/dev/null; then
    echo "==> Warning: Zen appears to be running."
    echo "==> Close Zen before updating Sine."
    return 1
  fi

  chrome="$profile/chrome"
  user_js="$profile/user.js"

  mkdir -p "$chrome"
  touch "$user_js"

  echo "==> Zen profile: $profile"
  echo "==> Zen installation: $zen_root"
  echo "==> Installing/updating Sine..."

  temp_dir="$(mktemp -d)"
  trap 'rm -rf -- "$temp_dir"' EXIT

  curl --fail --location --silent --show-error --retry 3 --connect-timeout 15 --max-time 120 \
    "https://github.com/sineorg/bootloader/releases/latest/download/program.zip" \
    --output "$temp_dir/program.zip"

  curl --fail --location --silent --show-error --retry 3 --connect-timeout 15 --max-time 120 \
    "https://github.com/sineorg/bootloader/releases/latest/download/profile.zip" \
    --output "$temp_dir/profile.zip"

  curl --fail --location --silent --show-error --retry 3 --connect-timeout 15 --max-time 120 \
    "https://github.com/CosmoCreeper/Sine/releases/latest/download/engine.zip" \
    --output "$temp_dir/engine.zip"

  echo "==> Installing Sine application bootloader..."

  # Installs:
  #   <Zen root>/config.js
  #   <Zen root>/defaults/pref/config-prefs.js
  mkdir -p "$temp_dir/program"
  unzip -oq "$temp_dir/program.zip" -d "$temp_dir/program"
  for program_file in config.js defaults/pref/config-prefs.js; do
    [[ -f "$temp_dir/program/$program_file" ]] || {
      echo "==> Error: Sine bootloader is missing $program_file" >&2
      return 1
    }
    if ! cmp -s "$temp_dir/program/$program_file" "$zen_root/$program_file"; then
      sudo install -D -m 0644 "$temp_dir/program/$program_file" "$zen_root/$program_file"
    fi
  done

  echo "==> Installing Sine profile bootloader and engine..."

  unzip -oq "$temp_dir/profile.zip" -d "$chrome"
  unzip -oq "$temp_dir/engine.zip" -d "$chrome"

  if [[ ! -f "$chrome/JS/sine.sys.mjs" ]]; then
    echo "==> Error: Sine engine was not extracted correctly."
    echo "==> Expected: $chrome/JS/sine.sys.mjs"
    rm -rf -- "$temp_dir"
    return 1
  fi

  if [[ ! -f "$chrome/JS/core/manager.sys.mjs" ]]; then
    echo "==> Error: Sine manager module was not found."
    echo "==> Sine may have changed its engine directory structure."
    rm -rf -- "$temp_dir"
    return 1
  fi

  echo "==> Configuring Zen and Sine preferences..."

  append_user_pref \
    "$user_js" \
    "toolkit.legacyUserProfileCustomizations.stylesheets" \
    "true"

  append_user_pref \
    "$user_js" \
    "browser.tabs.allow_transparent_browser" \
    "{{ if eq .chezmoi.hostname "tranquility" }}false{{ else }}true{{ end }}"

  append_user_pref \
    "$user_js" \
    "sine.allow-external-marketplace" \
    "true"

  append_user_pref \
    "$user_js" \
    "sine.allow-unsafe-js" \
    "true"

  append_user_pref \
    "$user_js" \
    "sine.auto-updates" \
    "true"

  install_sine_bootstrap "$chrome"
  connect_sine_bootstrap "$chrome"

  palette_source="$HOME/.local/state/caelestia/theme/caelestia-nebula.css"
  palette_link="$chrome/caelestia-nebula.css"

  mkdir -p "$(dirname "$palette_source")"
  ln -sfn "$palette_source" "$palette_link"
  nebula_config="$chrome/sine-mods/Nebula/nebula/config.css"
  if [[ -f "$nebula_config" ]] && ! grep -Fqx '@import url("../../../caelestia-nebula.css");' "$nebula_config"; then
    sed -i '1i @import url("../../../caelestia-nebula.css");' "$nebula_config"
  fi

  echo "==> Linked Caelestia palette:"
  echo "    $palette_link -> $palette_source"

  rm -rf -- "$temp_dir"

  echo
  echo "==> Sine installation complete."
  rm -rf -- "$profile/startupCache"
  echo "==> Start Zen to load the installed mods."
  echo
  echo "==> On startup, Sine will automatically install:"
  echo "    - Nebula"
  echo "    - Caelestia Nebula Hot Reload"
  echo
  echo "==> Browser Console messages use the prefix:"
  echo "    [chezmoi/Sine]"
)

connect_sine_bootstrap() {
  local chrome="$1"
  local sine_entry="$chrome/JS/sine.sys.mjs"
  local marker="chezmoi-sine-bootstrap-loader"

  if [[ ! -f "$sine_entry" ]]; then
    echo "==> Error: Sine entry module not found: $sine_entry"
    return 1
  fi

  if ! grep -Fq "$marker" "$sine_entry"; then
    cat >>"$sine_entry" <<'EOF'

// chezmoi-sine-bootstrap-loader
import("./zz-chezmoi-sine-bootstrap.sys.mjs").catch(error => {
  console.error("[chezmoi/Sine] Could not load bootstrap:", error);
});
EOF
  fi

  echo "==> Connected automatic mod bootstrap to Sine."
}

if ! command -v curl &>/dev/null; then
  echo "==> Error: curl is required for Sine installation." >&2
  exit 1
elif ! command -v unzip &>/dev/null; then
  echo "==> Error: unzip is required for Sine installation." >&2
  exit 1
else
  install_sine
fi
