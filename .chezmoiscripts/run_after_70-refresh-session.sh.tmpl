#!/usr/bin/env bash
set -euo pipefail
# No running desktop is required on a fresh machine. Refresh an existing session.
python - <<'PY'
import json, os, subprocess
from pathlib import Path
runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
if not runtime.is_dir():
    raise SystemExit(0)
os.environ['XDG_RUNTIME_DIR'] = str(runtime)
os.environ.setdefault('DBUS_SESSION_BUS_ADDRESS', f'unix:path={runtime}/bus')
result = subprocess.run(['hyprctl', 'instances', '-j'], capture_output=True, text=True)
if result.returncode != 0:
    raise SystemExit(0)
for instance in json.loads(result.stdout):
    env = os.environ | {'HYPRLAND_INSTANCE_SIGNATURE': instance['instance'],
                        'WAYLAND_DISPLAY': instance['wl_socket']}
    subprocess.run(['hyprctl', 'reload'], env=env, check=True)
    # The supervised bridge discovers the desktop instance even after SSH apply.
    subprocess.run(['systemctl', '--user', 'daemon-reload'], check=True)
    subprocess.run(['systemctl', '--user', 'enable', '--now', 'caelestia-keep-awake.service'], check=True)
PY
