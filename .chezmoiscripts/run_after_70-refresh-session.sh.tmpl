#!/usr/bin/env bash
set -euo pipefail
# No running desktop is required on a fresh machine. Refresh an existing session.
python - <<'PY'
import json, os, shlex, subprocess
from pathlib import Path
runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
if not runtime.is_dir():
    raise SystemExit(0)
os.environ['XDG_RUNTIME_DIR'] = str(runtime)
os.environ.setdefault('DBUS_SESSION_BUS_ADDRESS', f'unix:path={runtime}/bus')
result = subprocess.run(['hyprctl', 'instances', '-j'], capture_output=True, text=True)
if result.returncode != 0:
    raise SystemExit(0)
for instance in json.loads(result.stdout):
    env = os.environ | {'HYPRLAND_INSTANCE_SIGNATURE': instance['instance'],
                        'WAYLAND_DISPLAY': instance['wl_socket']}
    subprocess.run(['hyprctl', 'reload'], env=env, check=True)
    # Launch from the desktop session so logind sees an active local user,
    # even when chezmoi apply is invoked over SSH.
    command = shlex.quote(str(Path.home() / '.local/bin/caelestia-keep-awake'))
    subprocess.run(['hyprctl', 'dispatch', f'hl.dsp.exec_cmd({json.dumps(command)})'],
                   env=env, check=True)
PY
