#!/usr/bin/env bash

set -euo pipefail

setup_user="$(id -un)"

echo "==> Configuring user groups for user: $setup_user..."

{{ range .groups -}}
# Ensure group '{{ . }}' exists
if ! getent group "{{ . }}" >/dev/null 2>&1; then
  echo "  -> Creating missing group: {{ . }}"
  sudo groupadd -r "{{ . }}"
fi

# Add user to group if not already a member
if ! [[ " $(id -nG "$setup_user") " == *" {{ . }} "* ]]; then
  echo "  -> Adding $setup_user to group: {{ . }}"
  sudo usermod -aG "{{ . }}" "$setup_user"
else
  echo "  -> $setup_user is already in group: {{ . }}"
fi
{{ end -}}

echo "==> User group configuration complete."
