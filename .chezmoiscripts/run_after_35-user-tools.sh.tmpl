#!/usr/bin/env bash
set -euo pipefail
# Preserve extras on existing installations; restore innovation's S3 support.
if ! uv tool list | grep -q '^dvc '; then
    uv tool install 'dvc[s3]'
fi
# A launcher can exist even when npm skipped Claude's native optional package.
# Preserve a working native or npm installation; repair incomplete installations.
if ! command -v claude >/dev/null 2>&1 || ! claude --version >/dev/null 2>&1; then
    npm install --global --prefix "$HOME/.local" --ignore-scripts=false --include=optional @anthropic-ai/claude-code
    "$HOME/.local/bin/claude" --version
fi
{{ if eq .chezmoi.hostname "tranquility" }}
# Preserve the laptop's installed Rust channels without updating them on each apply.
for channel in stable nightly; do
    if ! rustup toolchain list | grep -q "^${channel}-"; then
        rustup toolchain install "$channel"
    fi
done
{{ end }}
