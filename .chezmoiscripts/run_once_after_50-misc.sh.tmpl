#!/usr/bin/env bash
# package.toml hash: {{ include "dot_config/yazi/package.toml" | sha256sum }}

set -euo pipefail

# ── Auto Login ───────────────────────────────────────────────────────────────
echo "==> Configuring SDDM autostart..."
sudo mkdir -p /etc/sddm.conf.d && printf "[Autologin]\nUser=$USER\nSession=hyprland\n" | sudo tee /etc/sddm.conf.d/autologin.conf > /dev/null

# ── Yazi ─────────────────────────────────────────────────────────────────────

if command -v ya &>/dev/null; then
  echo "==> Syncing Yazi plugins and flavors..."
  ya pkg install
  rm -rf /tmp/dynamic-yazi-caelestia-theme && \
  git clone https://github.com/einebrotscheibe/dynamic-yazi-caelestia-theme.git /tmp/dynamic-yazi-caelestia-theme && \
  bash /tmp/dynamic-yazi-caelestia-theme/setup.sh && \
  rm -rf /tmp/dynamic-yazi-caelestia-theme
else
  echo "==> Warning: Yazi package manager 'ya' not found. Skipping plugin sync."
fi

# ── Zen / Sine ───────────────────────────────────────────────────────────────

ZEN_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/zen"
PROFILES_INI="$ZEN_CONFIG/profiles.ini"

find_zen_profile() {
  [[ -f "$PROFILES_INI" ]] || return 1

  awk -F= -v base="$ZEN_CONFIG" '
    function resolve(path, relative) {
      if (path ~ /^\//)
        return path

      return relative == "0" ? path : base "/" path
    }

    function save_profile() {
      if (section !~ /^\[Profile/ || profile_path == "")
        return

      resolved = resolve(profile_path, relative)

      if (is_default == "1")
        default_profile = resolved

      if (fallback == "")
        fallback = resolved
    }

    /^\[/ {
      save_profile()

      section = $0
      profile_path = ""
      relative = "1"
      is_default = "0"
      next
    }

    section ~ /^\[Install/ && $1 == "Default" {
      install_profile = substr($0, index($0, "=") + 1)
      next
    }

    section ~ /^\[Profile/ && $1 == "Path" {
      profile_path = substr($0, index($0, "=") + 1)
      next
    }

    section ~ /^\[Profile/ && $1 == "IsRelative" {
      relative = $2
      next
    }

    section ~ /^\[Profile/ && $1 == "Default" {
      is_default = $2
      next
    }

    END {
      save_profile()

      if (install_profile != "")
        print resolve(install_profile, "1")
      else if (default_profile != "")
        print default_profile
      else if (fallback != "")
        print fallback
    }
  ' "$PROFILES_INI"
}

find_zen_root() {
  local candidate

  for candidate in \
    /opt/zen-browser-bin \
    /opt/zen-browser \
    /usr/lib/zen-browser \
    /usr/lib/zen; do
    if [[ -d "$candidate" ]] &&
      [[ -e "$candidate/zen" || -e "$candidate/zen-bin" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

append_user_pref() {
  local user_js="$1"
  local pref_name="$2"
  local pref_value="$3"
  local preference

  preference="user_pref(\"$pref_name\", $pref_value);"

  if ! grep -Fqx "$preference" "$user_js"; then
    printf '%s\n' "$preference" >>"$user_js"
  fi
}

install_sine_bootstrap() {
  local chrome="$1"
  local bootstrap

  bootstrap="$chrome/JS/zz-chezmoi-sine-bootstrap.sys.mjs"

  mkdir -p "$chrome/JS"

  cat >"$bootstrap" <<'EOF'
/*
 * Installs the chezmoi-managed Sine mods on first launch.
 *
 * This module remains installed, but stops doing work after the
 * sine.chezmoi-mods-installed preference is set.
 */

import manager from "./core/manager.sys.mjs";
import utils from "./core/utils.sys.mjs";

const COMPLETION_PREF = "sine.chezmoi-mods-installed";
const RELOAD_REPOSITORY =
  "https://github.com/1unarzDev/caelestia_nebula_hot_reload";

async function getInstalledMods() {
  try {
    return (await utils.getMods()) ?? {};
  } catch {
    return {};
  }
}

function hasReloadMod(mods) {
  return Object.values(mods).some(mod => {
    const homepage = String(mod?.homepage ?? "").toLowerCase();
    const name = String(mod?.name ?? "").toLowerCase();
    const id = String(mod?.id ?? "").toLowerCase();

    return (
      homepage.includes("1unarzdev/caelestia_nebula_hot_reload") ||
      name.includes("caelestia nebula hot reload") ||
      id.includes("caelestia_nebula_hot_reload") ||
      id.includes("caelestia-nebula-hot-reload")
    );
  });
}

async function installManagedMods() {
  if (Services.prefs.getBoolPref(COMPLETION_PREF, false)) {
    console.info("[chezmoi/Sine] Managed mods are already installed.");
    return;
  }

  try {
    /*
     * sine.sys.mjs loads this module asynchronously. Wait until Sine has
     * initialized its mod directory and mods.json.
     */
    for (let attempt = 0; attempt < 100; attempt++) {
      if (await IOUtils.exists(utils.modsDataFile)) {
        break;
      }

      await new Promise(resolve => {
        Services.tm.dispatchToMainThread(resolve);
      });
    }

    if (!(await IOUtils.exists(utils.modsDataFile))) {
      throw new Error("Sine did not initialize mods.json.");
    }
    let installed = await getInstalledMods();
    let changed = false;

    if (!installed.Nebula) {
      console.info("[chezmoi/Sine] Installing Nebula...");

      await manager.installMod(
        "Nebula",
        "store",
        false
      );

      changed = true;
      installed = await getInstalledMods();
    }

    if (!hasReloadMod(installed)) {
      console.info(
        "[chezmoi/Sine] Installing Caelestia Nebula hot reload..."
      );

      await manager.installMod(
        RELOAD_REPOSITORY,
        null,
        false
      );

      changed = true;
    }

    if (changed) {
      await manager.rebuildMods();
      await manager.loadMods();
    }

    const finalMods = await getInstalledMods();

    if (!finalMods.Nebula || !hasReloadMod(finalMods)) {
      throw new Error(
        "One or more managed Sine mods were not found after installation."
      );
    }

    Services.prefs.setBoolPref(COMPLETION_PREF, true);

    console.info(
      "[chezmoi/Sine] Automatic mod installation complete."
    );
  } catch (error) {
    /*
     * Do not set the completion preference when installation fails.
     * This allows another attempt on the next Zen launch.
     */
    console.error(
      "[chezmoi/Sine] Automatic mod installation failed:",
      error
    );
  }
}

installManagedMods();
EOF

  echo "==> Installed Sine mod bootstrap: $bootstrap"
}

install_sine() {
  local profile
  local chrome
  local zen_root
  local temp_dir
  local user_js
  local palette_source
  local palette_link

  if [[ ! -f "$PROFILES_INI" ]]; then
    echo "==> Warning: $PROFILES_INI does not exist."
    echo "==> Start Zen once, close it, and rerun chezmoi."
    return
  fi

  if ! profile="$(find_zen_profile)" || [[ -z "$profile" ]]; then
    echo "==> Warning: Could not determine the active Zen profile."
    return
  fi

  if [[ ! -d "$profile" ]]; then
    echo "==> Warning: Detected Zen profile does not exist:"
    echo "    $profile"
    echo "==> Start Zen once, close it, and rerun chezmoi."
    return
  fi

  if ! zen_root="$(find_zen_root)"; then
    echo "==> Warning: Zen installation directory could not be detected."
    return
  fi

  if pgrep -x zen &>/dev/null || pgrep -x zen-bin &>/dev/null; then
    echo "==> Warning: Zen appears to be running."
    echo "==> Close Zen before updating Sine."
    return
  fi

  chrome="$profile/chrome"
  user_js="$profile/user.js"

  mkdir -p "$chrome"
  touch "$user_js"

  echo "==> Zen profile: $profile"
  echo "==> Zen installation: $zen_root"
  echo "==> Installing/updating Sine..."

  temp_dir="$(mktemp -d)"

  curl --fail --location --silent --show-error \
    "https://github.com/sineorg/bootloader/releases/latest/download/program.zip" \
    --output "$temp_dir/program.zip"

  curl --fail --location --silent --show-error \
    "https://github.com/sineorg/bootloader/releases/latest/download/profile.zip" \
    --output "$temp_dir/profile.zip"

  curl --fail --location --silent --show-error \
    "https://github.com/CosmoCreeper/Sine/releases/latest/download/engine.zip" \
    --output "$temp_dir/engine.zip"

  echo "==> Installing Sine application bootloader..."

  # Installs:
  #   <Zen root>/config.js
  #   <Zen root>/defaults/pref/config-prefs.js
  sudo unzip -oq "$temp_dir/program.zip" -d "$zen_root"

  echo "==> Installing Sine profile bootloader and engine..."

  unzip -oq "$temp_dir/profile.zip" -d "$chrome"
  unzip -oq "$temp_dir/engine.zip" -d "$chrome"

  if [[ ! -f "$chrome/JS/sine.sys.mjs" ]]; then
    echo "==> Error: Sine engine was not extracted correctly."
    echo "==> Expected: $chrome/JS/sine.sys.mjs"
    rm -rf -- "$temp_dir"
    return 1
  fi

  if [[ ! -f "$chrome/JS/core/manager.sys.mjs" ]]; then
    echo "==> Error: Sine manager module was not found."
    echo "==> Sine may have changed its engine directory structure."
    rm -rf -- "$temp_dir"
    return 1
  fi

  echo "==> Configuring Zen and Sine preferences..."

  append_user_pref \
    "$user_js" \
    "toolkit.legacyUserProfileCustomizations.stylesheets" \
    "true"

  append_user_pref \
    "$user_js" \
    "browser.tabs.allow_transparent_browser" \
    "true"

  append_user_pref \
    "$user_js" \
    "sine.allow-external-marketplace" \
    "true"

  append_user_pref \
    "$user_js" \
    "sine.allow-unsafe-js" \
    "true"

  append_user_pref \
    "$user_js" \
    "sine.auto-updates" \
    "true"

  install_sine_bootstrap "$chrome"
  connect_sine_bootstrap "$chrome"

  palette_source="$HOME/.local/state/caelestia/theme/caelestia-nebula.css"
  palette_link="$chrome/caelestia-nebula.css"

  mkdir -p "$(dirname "$palette_source")"
  ln -sfn "$palette_source" "$palette_link"
  nebula_config="$chrome/sine-mods/Nebula/nebula/config.css"; [[ ! -f "$nebula_config" ]] || grep -Fqx '@import url("../../../caelestia-nebula.css");' "$nebula_config" || sed -i '1i @import url("../../../caelestia-nebula.css");' "$nebula_config"

  echo "==> Linked Caelestia palette:"
  echo "    $palette_link -> $palette_source"

  rm -rf -- "$temp_dir"

  echo
  echo "==> Sine installation complete."
  echo "==> Start Zen and clear the startup cache from about:support."
  echo "==> Restart Zen once more."
  echo
  echo "==> On startup, Sine will automatically install:"
  echo "    - Nebula"
  echo "    - Caelestia Nebula Hot Reload"
  echo
  echo "==> Browser Console messages use the prefix:"
  echo "    [chezmoi/Sine]"
}

connect_sine_bootstrap() {
  local chrome="$1"
  local sine_entry="$chrome/JS/sine.sys.mjs"
  local marker="chezmoi-sine-bootstrap-loader"

  if [[ ! -f "$sine_entry" ]]; then
    echo "==> Error: Sine entry module not found: $sine_entry"
    return 1
  fi

  if ! grep -Fq "$marker" "$sine_entry"; then
    cat >>"$sine_entry" <<'EOF'

// chezmoi-sine-bootstrap-loader
import("./zz-chezmoi-sine-bootstrap.sys.mjs").catch(error => {
  console.error("[chezmoi/Sine] Could not load bootstrap:", error);
});
EOF
  fi

  echo "==> Connected automatic mod bootstrap to Sine."
}

if ! command -v curl &>/dev/null; then
  echo "==> Warning: curl is required for Sine installation."
elif ! command -v unzip &>/dev/null; then
  echo "==> Warning: unzip is required for Sine installation."
else
  install_sine
fi
