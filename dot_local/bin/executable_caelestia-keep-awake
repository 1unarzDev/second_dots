#!/usr/bin/env python3
"""Mirror Caelestia Keep Awake into logind sleep and lid inhibitors."""
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import time


def main():
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    # Exit with the compositor so a later login cannot inherit a stale bridge.
    instances = subprocess.run(["hyprctl", "instances", "-j"],
                               capture_output=True, text=True, check=True)
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    compositor = next((instance["pid"] for instance in json.loads(instances.stdout)
                       if instance["instance"] == signature), None)
    if compositor is None:
        return
    with (runtime / "caelestia-keep-awake.lock").open("w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        inhibitor = None
        running = True

        def stop(*_):
            nonlocal running
            running = False

        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        try:
            while running:
                try:
                    os.kill(compositor, 0)
                except ProcessLookupError:
                    break
                try:
                    result = subprocess.run(
                        ["caelestia", "shell", "idleInhibitor", "isEnabled"],
                        capture_output=True, text=True, timeout=3,
                    )
                    enabled = result.returncode == 0 and result.stdout.strip() == "true"
                except (subprocess.TimeoutExpired, OSError):
                    enabled = False
                if enabled and (inhibitor is None or inhibitor.poll() is not None):
                    inhibitor = subprocess.Popen([
                        "systemd-inhibit", "--what=idle:sleep:handle-lid-switch",
                        "--mode=block", "--who=Caelestia Keep Awake",
                        "--why=Keep Awake enabled in Caelestia", "sleep", "infinity",
                    ])
                elif not enabled and inhibitor is not None:
                    inhibitor.terminate()
                    inhibitor.wait()
                    inhibitor = None
                time.sleep(1)
        finally:
            if inhibitor is not None and inhibitor.poll() is None:
                inhibitor.terminate()
                inhibitor.wait()


if __name__ == "__main__":
    main()
