#!/usr/bin/env python3
"""Supervised Keep Awake bridge; preserve state across shell restarts and updates."""
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def call(args, env=None):
    try:
        return subprocess.run(args, env=env, capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.TimeoutExpired):
        return None


class AwakeState:
    def __init__(self, enabled=False):
        self.enabled = enabled
        self.shell_pid = None

    def observe(self, pid, read, restore):
        if pid is None:
            return self.enabled
        if pid != self.shell_pid:
            # A newly launched shell may reset its UI toggle. Restore the prior
            # enabled state before accepting a new shell's default false value.
            if self.enabled and not restore():
                return True
            self.shell_pid = pid
        value = read()
        if value is not None:
            self.enabled = value
        return self.enabled


def read_enabled(env):
    r = call(['caelestia', 'shell', 'idleInhibitor', 'isEnabled'], env)
    if r is None or r.returncode or r.stdout.strip() not in ('true', 'false'):
        return None
    return r.stdout.strip() == 'true'


def restore_enabled(env):
    r = call(['caelestia', 'shell', 'idleInhibitor', 'enable'], env)
    return r is not None and r.returncode == 0


def shell_pid(env):
    r = call(['qs', '-c', 'caelestia', 'list', '-j'], env)
    if r is None or r.returncode:
        return None
    try:
        instances = json.loads(r.stdout)
        return instances[0]['pid'] if instances else None
    except (ValueError, KeyError, TypeError):
        return None


def main():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}'))
    r = call(['hyprctl', 'instances', '-j'])
    if r is None or r.returncode:
        return
    instances = json.loads(r.stdout)
    signature = os.environ.get('HYPRLAND_INSTANCE_SIGNATURE')
    compositor = next((i for i in instances if i['instance'] == signature), None)
    if compositor is None and instances:
        compositor = instances[0]
    if compositor is None:
        return
    env = os.environ | {'HYPRLAND_INSTANCE_SIGNATURE': compositor['instance'],
                        'WAYLAND_DISPLAY': compositor['wl_socket'],
                        'XDG_RUNTIME_DIR': str(runtime)}
    root = Path(os.environ.get('XDG_STATE_HOME', str(Path.home()/'.local/state')))/'caelestia-keep-awake'
    root.mkdir(parents=True, exist_ok=True)
    root.chmod(0o700)
    saved = root/'enabled.json'
    try:
        previous = json.loads(saved.read_text()) is True
    except (OSError, ValueError):
        previous = False
    state = AwakeState(previous)
    with (runtime/'caelestia-keep-awake.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        inhibitor = None
        running = True
        def stop(*_):
            nonlocal running
            running = False
        signal.signal(signal.SIGTERM, stop)
        signal.signal(signal.SIGINT, stop)
        try:
            while running:
                try:
                    os.kill(compositor['pid'], 0)
                except ProcessLookupError:
                    break
                old = state.enabled
                enabled = state.observe(shell_pid(env), lambda: read_enabled(env), lambda: restore_enabled(env))
                if enabled != old or not saved.exists():
                    temporary = root/'enabled.tmp'
                    temporary.write_text(json.dumps(enabled)+'\n')
                    temporary.chmod(0o600)
                    temporary.replace(saved)
                if enabled and (inhibitor is None or inhibitor.poll() is not None):
                    inhibitor = subprocess.Popen([
                        'systemd-inhibit', '--what=idle:sleep:handle-lid-switch', '--mode=block',
                        '--who=Caelestia Keep Awake', '--why=Keep Awake enabled in Caelestia',
                        'sleep', 'infinity'])
                elif not enabled and inhibitor is not None:
                    if inhibitor.poll() is None:
                        inhibitor.terminate()
                    inhibitor.wait()
                    inhibitor = None
                time.sleep(0.5)
        finally:
            if inhibitor is not None and inhibitor.poll() is None:
                inhibitor.terminate()
                inhibitor.wait()


def retire_legacy():
    helper = str(Path(__file__).resolve())
    for process in Path('/proc').iterdir():
        if not process.name.isdigit() or int(process.name) == os.getpid():
            continue
        try:
            if process.stat().st_uid != os.getuid():
                continue
            args = (process/'cmdline').read_bytes().decode().split('\0')
            if helper not in args or 'caelestia-keep-awake.service' in (process/'cgroup').read_text():
                continue
            os.kill(int(process.name), signal.SIGTERM)
        except (OSError, UnicodeError):
            continue


if __name__ == '__main__':
    if sys.argv[1:] == ['--retire-legacy']:
        retire_legacy()
    else:
        main()
